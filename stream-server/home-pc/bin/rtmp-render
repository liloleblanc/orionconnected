#!/usr/bin/env bash
# Writes the nginx relay config for stream N to /run/fids-home/rtmp-N/nginx.conf.
# Runs as root before the relay starts (ExecStartPre of fids-home-rtmp@N).
#
# The stream key is read from /etc/credstore with bash builtins only (read,
# parameter expansion, printf), so it never appears in an argument list, and
# it is never printed. Only the first 8 hex characters of its sha256 are shown.
# The relay pushes to YouTube only when OUTPUT=youtube and a key is saved;
# otherwise it accepts the local stream and sends it nowhere.
set -euo pipefail
N="${1:-}"
case "$N" in 1|2) ;; *) echo "usage: rtmp-render 1|2" >&2; exit 2 ;; esac

TMPL="${RTMP_TEMPLATE:-/opt/fids-home/config/rtmp.conf.tmpl}"
OUT_DIR="/run/fids-home/rtmp-$N"
KEY_FILE="/etc/credstore/fids-stream-$N.key"
STATUS_DIR="/run/fids-home/status"
PORT="${RTMP_PORT:-$((1935 + N))}"
PUSH_BASE="${PUSH_BASE:-rtmp://a.rtmp.youtube.com/live2}"
OUTPUT="${OUTPUT:-youtube}"

install -d -m 0755 "$STATUS_DIR"
install -d -m 0700 "$OUT_DIR"

KEY=""
if [ -s "$KEY_FILE" ]; then
  IFS= read -r KEY < "$KEY_FILE" || true
  KEY="${KEY//[[:space:]]/}"
  if ! [[ "$KEY" =~ ^[A-Za-z0-9-]{8,64}$ ]]; then
    echo "rtmp-render[$N]: the saved key has unexpected characters; not using it (run: sudo set-stream-key $N)" >&2
    KEY=""
  fi
fi

PUSH=""
if [ "$OUTPUT" = youtube ] && [ -n "$KEY" ]; then
  PUSH="push $PUSH_BASE/$KEY;"
fi

CONF="$(<"$TMPL")"
CONF="${CONF//@N@/$N}"
CONF="${CONF//@PORT@/$PORT}"
CONF="${CONF//@PUSH@/$PUSH}"
umask 077
printf '%s\n' "$CONF" > "$OUT_DIR/nginx.conf"
unset CONF PUSH KEY

if [ "$OUTPUT" = youtube ] && [ -s "$KEY_FILE" ] && grep -q '^ *push ' "$OUT_DIR/nginx.conf"; then
  FP="$(sha256sum < "$KEY_FILE" | cut -c1-8)"
  printf '%s\n' "$FP" > "$STATUS_DIR/push-$N"
  chmod 0644 "$STATUS_DIR/push-$N"
  echo "rtmp-render[$N]: relay on 127.0.0.1:$PORT, pushing to $PUSH_BASE (key fingerprint $FP)"
else
  rm -f "$STATUS_DIR/push-$N"
  if [ "$OUTPUT" = youtube ]; then
    echo "rtmp-render[$N]: relay on 127.0.0.1:$PORT, NO key saved, nothing is pushed (run: sudo set-stream-key $N)"
  else
    echo "rtmp-render[$N]: relay on 127.0.0.1:$PORT, OUTPUT=$OUTPUT, nothing is pushed"
  fi
fi
