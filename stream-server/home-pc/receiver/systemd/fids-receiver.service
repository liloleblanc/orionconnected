[Unit]
Description=ADS-B receiver (readsb): writes local JSON, no network
After=systemd-udevd.service
# Keeps trying while the stick is unplugged.
StartLimitIntervalSec=0

[Service]
Type=simple
# No receiver position is given: positions come from pairs of airborne
# messages, and nothing on disk says where the antenna is.
ExecStart=/opt/fids-receiver/bin/readsb --device-type rtlsdr --gain auto --quiet --no-interactive --write-json /run/fids-receiver --write-json-every 1 --json-location-accuracy 0
RuntimeDirectory=fids-receiver
RuntimeDirectoryMode=0755
Restart=always
RestartSec=30

# The streams come first.
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=512M
TasksMax=64

# A throwaway user with one device and no network. The program only reads the
# USB stick and writes its JSON folder.
DynamicUser=yes
SupplementaryGroups=plugdev
DevicePolicy=closed
DeviceAllow=char-usb_device rw
PrivateNetwork=yes
IPAddressDeny=any
# netlink: libusb listens for USB devices coming and going.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
LimitCORE=0

[Install]
WantedBy=multi-user.target
