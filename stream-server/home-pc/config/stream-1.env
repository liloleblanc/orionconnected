# Stream 1, Moncton. The same board address as the cloud box (setup.sh default).
# Read by systemd: one KEY=value per line, comments on their own lines only.
STREAM_URL="https://fids.orionconnected.com/rotate.html?ap=YQM&mode=live&stream=1&langs=en,fr&rotate=fids,gids,bids,gids&dwell=60"
WIDTH=1920
HEIGHT=1080
FRAMERATE=30
VIDEO_BITRATE=8M
# gpu or software (Chrome drawing); the bench chose gpu
RENDER=gpu
# nvenc or x264 (video encoder); the bench chose nvenc (less CPU, steadier frames)
ENCODER=nvenc
# youtube, local (relay without push), file:/path, null, or direct (emergency only)
OUTPUT=youtube
DISPLAY_NUM=91
RTMP_PORT=1936
# 1 = start Chrome on about:blank, block the billed proxy paths, then load the board
NET_GUARD=0
CDP_PORT=
# demo = load the board with mode=demo instead of mode=live (tests and soaks)
MODE_OVERRIDE=
# a direct audio stream address; empty = silent audio
MUSIC_URL=
