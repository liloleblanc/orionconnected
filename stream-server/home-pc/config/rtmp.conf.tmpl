# nginx relay for one home stream. rtmp-render fills in @N@, @PORT@ and @PUSH@
# and writes the result to /run/fids-home/rtmp-@N@/nginx.conf (root only).
load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;
user fidsstream fidsstream;
worker_processes 1;
pid /run/fids-home/rtmp-@N@/nginx.pid;
error_log stderr warn;
events { worker_connections 32; }
rtmp {
    access_log off;
    server {
        listen 127.0.0.1:@PORT@;
        chunk_size 4096;
        application s {
            live on;
            record off;
            allow publish 127.0.0.1;
            deny publish all;
            allow play 127.0.0.1;
            deny play all;
            push_reconnect 2s;
            @PUSH@
        }
    }
}
