{
  "name": "grocery-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grocery list planner: enter a list and a postal code, get this week's best prices nearby and a plan for where to shop.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "node scripts/demo.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute grocery-planner --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.144.0"
  }
}
